# Flash integrator key. Leave empty to use the public dev key for read-only quotes.
FLASH_API_KEY=

# Spike only: private key of a dedicated test wallet with a small balance. Never a main wallet.
SPIKE_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org

# Worker
BOT_TOKEN=
DATABASE_URL=
# Platform fee in basis points. 0 = no fee, 10 = 0.10%. Fees go to your Definitive account.
PLATFORM_FEE_BPS=0

# Web. Get the app ID from dashboard.privy.io. Without it, wallet login is disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# 32 random bytes as hex: openssl rand -hex 32
SESSION_SECRET=

# Optional. Base builder code from base.dev, added to orders placed on the web.
BUILDER_CODE=
# Optional. A key for token search if yours gets SEARCH_NOT_ELIGIBLE. Defaults to Flash's public key.
FLASH_SEARCH_KEY=

# Worker. Your public https site, for Mini App buttons. Telegram won't open http links.
APP_URL=

# Set to false to stop auto-copy for every user at once.
AUTO_COPY_ENABLED=true

# Privy wallets for Telegram and auto-copy. The worker needs all of these.
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# Set to true after enabling Telegram in the Privy dashboard.
NEXT_PUBLIC_PRIVY_TELEGRAM=
