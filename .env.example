# Flash integrator key. Leave empty to use the public dev key for read-only quotes.
FLASH_API_KEY=

# Spike only: private key of a dedicated test wallet with a small balance. Never a main wallet.
SPIKE_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org

# Worker
BOT_TOKEN=
DATABASE_URL=
# 32 random bytes as hex: openssl rand -hex 32. Losing this makes every bot wallet unrecoverable.
WALLET_MASTER_KEY=
# 10 = 0.10%
PLATFORM_FEE_BPS=10
